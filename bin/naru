#!/bin/sh
# The Naru command. A thin front door over install.sh, naru-native.mjs and naru-doctor.js:
# every mutating subcommand previews first and asks before changing anything.
set -eu

REPO=${NARU_REPO:-sean35mm/naru-opencode}
NARU_HOME=${NARU_HOME:-"${HOME}/.naru"}
API=${NARU_API:-"https://api.github.com/repos/${REPO}"}

# Resolve the release directory this script lives in, following the shim symlink.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)
INSTALLER="${ROOT}/install.sh"
DOCTOR="${ROOT}/tools/naru-doctor.js"
NATIVE="${ROOT}/tools/naru-native.mjs"

usage() {
  cat <<'EOF'
Naru — thin hard walls, free interior.

Usage: naru <command> [options]

  install [opts]     Install Naru into OpenCode (previews, then asks)
  configure          Select normal native worker models interactively
  models --list|--set REF[,REF]  Inspect or change native worker pool
  uninstall [opts]   Remove Naru from OpenCode (previews, then asks)
  upgrade [opts]     Fetch the latest release, then install it
  doctor             Report local install and configuration health
  version            Show installed and latest available versions
  help               Show this message

Install/upgrade/uninstall options:
  --apply            Skip the confirmation prompt (for non-interactive use)
  --preview          Print the plan and exit without prompting or applying
  --opencode PATH    Use this absolute OpenCode executable (install/upgrade)
  --dir PATH         Use an exact OpenCode config directory

Everything that changes your machine previews first. Nothing is written
until you confirm, or pass --apply.
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "naru: required command not found: $1" >&2; exit 1; }
}

installed_version() {
  if [ -f "${ROOT}/VERSION" ]; then
    tr -d ' \n' < "${ROOT}/VERSION"
  else
    echo "unknown"
  fi
}

latest_version() {
  need curl
  need node
  curl -fsSL "${API}/releases/latest" 2>/dev/null \
    | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const t=JSON.parse(s).tag_name;if(typeof t==="string"&&t)process.stdout.write(t)}catch{}})' \
    || true
}

install_step() {
  [ -f "$INSTALLER" ] || { echo "naru: installer not found at ${INSTALLER}" >&2; exit 1; }
  sh "$INSTALLER" "$@"
}
uninstall_step() {
  # The native uninstaller exits 3 when Naru is not installed: nothing to confirm.
  status=0
  node "$NATIVE" uninstall "$@" || status=$?
  [ "$status" -ne 3 ] || { nothing=true; return 0; }
  return "$status"
}

# Runs a step in preview mode, then asks. `--apply` anywhere in the caller's
# arguments skips the prompt and applies directly.
run_previewed() {
  step=$1
  shift
  apply=false
  preview=false
  nothing=false
  for arg in "$@"; do
    [ "$arg" = --apply ] && apply=true
    [ "$arg" = --preview ] && preview=true
  done
  if [ "$apply" = true ] && [ "$preview" = true ]; then
    echo "naru: --preview and --apply cannot be combined" >&2
    exit 2
  fi

  if [ "$apply" = true ]; then
    # Caller already opted in; pass through untouched.
    "$step" "$@"
    return
  fi
  "$step" --preview "$@"
  [ "$preview" = false ] && [ "$nothing" = false ] || return 0

  if [ ! -t 0 ]; then
    echo
    echo "Not an interactive terminal. Rerun with --apply to proceed."
    return
  fi

  printf '\nApply these changes? [y/N] '
  read -r reply || reply=""
  case "$reply" in
    y|Y|yes|YES)
      echo
      "$step" --apply "$@"
      ;;
    *) echo "Cancelled. Nothing was changed." ;;
  esac
}

command=${1:-help}
[ $# -gt 0 ] && shift

case "$command" in
  configure|models)
    need node
    [ -f "$NATIVE" ] || { echo "naru: compiled native installer is unavailable" >&2; exit 1; }
    exec node "$NATIVE" "$command" "$@"
    ;;
  install)
    run_previewed install_step "$@"
    ;;

  uninstall)
    need node
    [ -f "$NATIVE" ] || { echo "naru: compiled native installer is unavailable" >&2; exit 1; }
    run_previewed uninstall_step "$@"
    ;;

  upgrade)
    need curl
    current=$(installed_version)
    latest=$(latest_version)
    if [ -z "$latest" ]; then
      echo "naru: could not reach the release API for ${REPO}" >&2
      exit 1
    fi
    plain=${latest#v}
    if [ "$plain" = "$current" ]; then
      echo "Naru ${current} is already the latest release."
      echo "Reinstalling the current version:"
      echo
      run_previewed install_step "$@"
      exit 0
    fi
    echo "Upgrading Naru ${current} -> ${plain}"
    echo
    # The bootstrap is the single place that knows how to fetch and verify a
    # release, so upgrade reuses it rather than duplicating that logic.
    boot="${ROOT}/bootstrap.sh"
    if [ -f "$boot" ]; then
      sh "$boot" --version "$latest"
    else
      curl -fsSL "https://raw.githubusercontent.com/${REPO}/${latest}/bootstrap.sh" | sh -s -- --version "$latest"
    fi
    echo
    echo "Downloaded. Now installing ${plain} into OpenCode:"
    echo
    exec "${NARU_HOME}/current/bin/naru" install "$@"
    ;;

  doctor)
    need node
    [ -f "$DOCTOR" ] || { echo "naru: doctor not found at ${DOCTOR}" >&2; exit 1; }
    node "$DOCTOR" "$@"
    ;;

  rollback)
    echo "naru: rollback is not available for native installs. Nothing was changed." >&2
    echo "Run 'naru uninstall' to remove Naru, or 'naru install' to reinstall this release." >&2
    exit 2
    ;;

  version|--version|-v)
    current=$(installed_version)
    echo "naru ${current}"
    echo "  release dir: ${ROOT}"
    latest=$(latest_version)
    if [ -n "$latest" ]; then
      plain=${latest#v}
      if [ "$plain" = "$current" ]; then
        echo "  latest:      ${plain} (up to date)"
      else
        echo "  latest:      ${plain} (run: naru upgrade)"
      fi
    else
      echo "  latest:      unavailable (offline or no releases yet)"
    fi
    ;;

  help|--help|-h)
    usage
    ;;

  *)
    echo "naru: unknown command: ${command}" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
